<div class="workouts-set" data-workout-form-set <%= "hidden" if set_form.object.marked_for_destruction? %>>
  <%= set_form.hidden_field :id, data: { set_id: true } if set_form.object.persisted? %>
  <%= set_form.hidden_field :_destroy, value: set_form.object.marked_for_destruction? ? "1" : "0", data: { set_destroy: true } %>
  <h3 class="workouts-set-title" data-set-label><%= set_form.object.set_number %>セット目</h3>
  <%= set_form.hidden_field :set_number, data: { set_number: true } %>
  <div class="workouts-set-grid">
    <div class="workouts-field">
      <%= set_form.label :weight_kg, "重量（kg）" %>
      <%= set_form.number_field :weight_kg, step: 0.01, min: 0, max: 9999.99, inputmode: "decimal", placeholder: "空欄＝自重" %>
    </div>
    <div class="workouts-field">
      <%= set_form.label :reps, "回数" %>
      <%= set_form.number_field :reps, min: 1, max: 10000, step: 1, required: true, inputmode: "numeric", placeholder: "例：10" %>
    </div>
  </div>
  <button type="button" class="workouts-button workouts-button-danger" data-action="workout-form#removeSet">セットを削除</button>
</div>
