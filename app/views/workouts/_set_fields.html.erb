
<div class="workouts-set" data-workout-form-set>

  <h3 class="workouts-set-title" data-set-label>
    <%= set_form.object.set_number %>セット目
  </h3>

  <%= set_form.hidden_field :set_number,
                            data: { set_number: true } %>

  <div class="workouts-field">
    <%= set_form.label :weight_kg, "重量（kg）" %>
    <%= set_form.number_field :weight_kg,
                              step: 0.5,
                              min: 0,
                              placeholder: "例：60" %>
  </div>

  <div class="workouts-field">
    <%= set_form.label :reps, "回数" %>
    <%= set_form.number_field :reps,
                              min: 1,
                              required: true,
                              placeholder: "例：10" %>
  </div>

  <button
    type="button"
    class="workouts-button workouts-button-danger"
    data-action="click->workout-form#removeSet">
    セットを削除
  </button>

</div>
