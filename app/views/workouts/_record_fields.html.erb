<section data-workout-form-record>
  <hr>

  <h2>トレーニング種目</h2>

  <div>
    <%= record_form.label :exercise_id, "種目名" %>

    <%= record_form.collection_select(
      :exercise_id,
      exercises,
      :id,
      :name,
      { prompt: "種目を選択してください" },
      { required: true }
    ) %>
  </div>

  <div data-workout-form-sets>
    <%= record_form.fields_for :workout_sets do |set_form| %>
      <%= render "set_fields", set_form: set_form %>
    <% end %>
  </div>

  <template data-workout-form-set-template>
    <%= record_form.fields_for :workout_sets,
                               WorkoutSet.new,
                               child_index: "NEW_SET" do |set_form| %>
      <%= render "set_fields", set_form: set_form %>
    <% end %>
  </template>

  <button type="button"
          data-action="click->workout-form#addSet">
    ＋セットを追加
  </button>

  <button type="button"
          data-action="click->workout-form#removeRecord">
    この種目を削除
  </button>
</section>