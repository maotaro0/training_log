<h1>新しいトレーニング記録</h1>

<% if @workout.errors.any? %>
  <div>
    <h2>入力内容を確認してください</h2>

    <ul>
      <% @workout.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div data-controller="workout-form">
  <%= form_with model: @workout do |form| %>
  

  <div>
    <%= form.label :date, "トレーニング日" %>
    <%= form.date_field :date, required: true %>
  </div>

  <div>
    <%= form.label :memo, "メモ" %>
    <%= form.text_area :memo %>
  </div>

  <div data-workout-form-target="records">
      <%= form.fields_for :workout_records do |record_form| %>
        <%= render "record_fields",
                   record_form: record_form,
                   exercises: @exercises %>
      <% end %>
    </div>

    <template data-workout-form-target="recordTemplate">
      <%= form.fields_for :workout_records,
                          WorkoutRecord.new,
                          child_index: "NEW_RECORD" do |record_form| %>
        <%= render "record_fields",
                   record_form: record_form,
                   exercises: @exercises %>
      <% end %>
    </template>

    <button type="button"
            data-action="click->workout-form#addRecord">
      ＋種目を追加
    </button>

  <div>
    <%= form.submit "トレーニングを保存" %>
  </div>

<% end %>
</div>