<% if @workout.errors.any? %>
  <div class="workouts-errors" role="alert" tabindex="-1">
    <h2>入力内容を確認してください</h2>
    <ul><% @workout.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
  </div>
<% end %>
<%= form_with model: @workout, data: { controller: "workout-form" } do |form| %>
  <section class="workouts-card">
    <h2 class="workouts-card-title">トレーニング情報</h2>
    <div class="workouts-field">
      <%= form.label :date, "トレーニング日" %>
      <%= form.date_field :date, required: true %>
    </div>
    <div class="workouts-field">
      <%= form.label :memo, "メモ（任意）" %>
      <%= form.text_area :memo, maxlength: 5000, placeholder: "今日の体調や、次回意識したいこと" %>
    </div>
  </section>
  <p class="workouts-subtitle">重量を空欄にすると「自重」で記録します。種目は30個、各種目のセットは100個まで追加できます。</p>
  <div data-workout-form-target="records">
    <%= form.fields_for :workout_records, include_id: false do |record_form| %>
      <%= render "record_fields", record_form: record_form, exercises: @exercises %>
    <% end %>
  </div>
  <template data-workout-form-target="recordTemplate">
    <%= form.fields_for :workout_records, WorkoutRecord.new, child_index: "NEW_RECORD", include_id: false do |record_form| %>
      <%= render "record_fields", record_form: record_form, exercises: @exercises %>
    <% end %>
  </template>
  <button type="button" class="workouts-button workouts-button-secondary" data-action="workout-form#addRecord">＋ 種目を追加</button>
  <%= form.submit @workout.persisted? ? "変更を保存" : "トレーニングを保存", class: "workouts-button", data: { turbo_submits_with: "保存中…" } %>
<% end %>
