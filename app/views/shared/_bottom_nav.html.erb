<% active = local_assigns.fetch(:active, nil) %>

<nav class="bottom-nav">

  <%= link_to root_path,
              class: "nav-item #{'nav-item-active' if active == :home}" do %>

    <span class="nav-symbol">⌂</span>
    <span>ホーム</span>

  <% end %>


  <%= link_to new_workout_path,
              class: "nav-item #{'nav-item-active' if active == :record}" do %>

    <span class="nav-symbol nav-plus">＋</span>
    <span>記録する</span>

  <% end %>


  <%= link_to workouts_path,
              class: "nav-item #{'nav-item-active' if active == :analysis}" do %>

    <span class="nav-symbol">▥</span>
    <span>成長分析</span>

  <% end %>


  <%= link_to profile_path,
              class: "nav-item #{'nav-item-active' if active == :settings}" do %>

    <span class="nav-symbol">⚙</span>
    <span>マイページ</span>

  <% end %>

</nav>