<main class="workouts-page"><div class="workouts-shell">
  <h1 class="workouts-title">マイページ</h1><p class="workouts-subtitle">あなたのペースで、トレーニングを続けよう。</p>
  <section class="workouts-card">
    <div class="profile-avatar"><% if @profile.avatar? %><%= image_tag avatar_profile_path, alt: "プロフィール画像" %><% else %><%= (@profile.name.presence || current_user.email).first.upcase %><% end %></div>
    <h2 class="workouts-card-title"><%= @profile.name.presence || "名前未設定" %></h2>
    <% if current_user.guest? %><p class="guest-notice">ゲスト体験中。ログアウト時に記録を削除します。ログアウトしない場合も24時間で利用期限が切れます。</p><% else %><p class="workouts-memo"><%= current_user.email %></p><% end %>
    <p>月間目標：<%= @profile.monthly_goal %>日</p>
    <%= link_to "プロフィールを編集", edit_profile_path, class: "workouts-button" %>
    <%= link_to "自分の種目を管理", exercises_path, class: "workouts-button workouts-button-secondary" %>
    <% unless current_user.guest? %><%= link_to "アカウント設定", edit_user_registration_path, class: "workouts-button workouts-button-secondary" %><% end %>
    <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "workouts-button workouts-button-secondary" %>
  </section>
  <%= render "shared/bottom_nav", active: :settings %>
</div></main>
