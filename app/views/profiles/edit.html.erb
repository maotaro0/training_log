<div class="records-page">
  <div class="records-shell">
    <header class="subpage-header">
      <h1>プロフィール編集</h1>
      <p class="subpage-description">
        マイページに表示する名前を設定できます。
      </p>
    </header>

    <main class="record-form-main">
      <section class="record-form-card">
        <div class="form-introduction">
          <div>
            <h2>名前の設定</h2>
            <p>表示したい名前を入力してください。</p>
          </div>
        </div>

        <%= form_with model: @profile, url: profile_path, method: :patch, class: "training-form" do |form| %>
          <div class="form-field">
            <label for="profile_name" class="form-label">名前</label>
            <%= form.text_field :name, class: "form-control" %>
          </div>

          <div class="form-submit-area">
            <%= form.submit "変更を保存する", class: "form-submit-button" %>
            <%= link_to "キャンセル", profile_path, class: "form-cancel-button" %>
          </div>
        <% end %>
      </section>
    </main>
    <%= render "shared/bottom_nav", active: :settings %>
  </div>
</div>