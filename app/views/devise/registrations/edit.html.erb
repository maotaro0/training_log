<div class="records-page">
  <div class="records-shell">
    <header class="subpage-header">
      <h1>アカウント設定</h1>
      <p class="subpage-description">
        メールアドレスやパスワードを変更できます。
      </p>
    </header>

    <main class="records-main">
      <section class="record-form-card">
        <%= form_for(resource,
                     as: resource_name,
                     url: registration_path(resource_name),
                     html: {
                       method: :put,
                       class: "training-form"
                     }) do |f| %>

          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="form-field">
            <%= f.label :email, "メールアドレス", class: "form-label" %>
            <%= f.email_field :email,
                              autofocus: true,
                              autocomplete: "email",
                              class: "form-control" %>
          </div>

          <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
            <p class="subpage-description">
              確認待ちのメールアドレス：<%= resource.unconfirmed_email %>
            </p>
          <% end %>

          <div class="form-field">
            <%= f.label :password, "新しいパスワード", class: "form-label" %>
            <p class="subpage-description">
              変更しない場合は空欄にしてください。
            </p>
            <%= f.password_field :password,
                                 autocomplete: "new-password",
                                 class: "form-control" %>

            <% if @minimum_password_length %>
              <p class="subpage-description">
                <%= @minimum_password_length %>文字以上で入力してください。
              </p>
            <% end %>
          </div>

          <div class="form-field">
            <%= f.label :password_confirmation,
                        "新しいパスワード（確認）",
                        class: "form-label" %>
            <%= f.password_field :password_confirmation,
                                 autocomplete: "new-password",
                                 class: "form-control" %>
          </div>

          <div class="form-field">
            <%= f.label :current_password,
                        "現在のパスワード",
                        class: "form-label" %>
            <p class="subpage-description">
              変更を保存するために入力してください。
            </p>
            <%= f.password_field :current_password,
                                 autocomplete: "current-password",
                                 class: "form-control" %>
          </div>

          <div class="form-submit-area">
            <%= f.submit "変更を保存する", class: "form-submit-button" %>
          </div>
        <% end %>

        <div class="auth-links">
          <%= link_to "戻る", :back %>
        </div>
      </section>

      <section class="records-card">
        <h3>退会</h3>
        <p class="subpage-description">
          アカウントを削除する場合はこちらから操作できます。
        </p>

        <div class="history-actions">
          <%= button_to "アカウントを削除する",
                        registration_path(resource_name),
                        method: :delete,
                        data: {
                          confirm: "アカウントを削除しますか？",
                          turbo_confirm: "アカウントを削除しますか？"
                        },
                        class: "history-delete-button" %>
        </div>
      </section>
    </main>
    <%= render "shared/bottom_nav", active: :settings %>
  </div>
</div>