<div class="records-page">
  <div class="records-shell">
    <header class="subpage-header">
      <h1>ジムログ</h1>
      <p class="subpage-description">
        アカウントを作成して、トレーニングを記録しましょう。
      </p>
    </header>

    <main class="record-form-main">
      <section class="record-form-card">
        <div class="form-introduction">
          <div>
            <h2>新規登録</h2>
            <p>メールアドレスとパスワードを設定してください。</p>
          </div>
        </div>

        <%= form_for(resource,
                     as: resource_name,
                     url: registration_path(resource_name),
                     html: { class: "training-form" }) do |f| %>

          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="form-field">
            <%= f.label :email, "メールアドレス", class: "form-label" %>
            <%= f.email_field :email,
                              autofocus: true,
                              autocomplete: "email",
                              class: "form-control" %>
          </div>

          <div class="form-field">
            <%= f.label :password, "パスワード", class: "form-label" %>

            <% if @minimum_password_length %>
              <p class="subpage-description">
                <%= @minimum_password_length %>文字以上で入力してください。
              </p>
            <% end %>

            <%= f.password_field :password,
                                 autocomplete: "new-password",
                                 class: "form-control" %>
          </div>

          <div class="form-field">
            <%= f.label :password_confirmation,
                        "パスワード（確認）",
                        class: "form-label" %>
            <%= f.password_field :password_confirmation,
                                 autocomplete: "new-password",
                                 class: "form-control" %>
          </div>

          <div class="form-submit-area">
            <%= f.submit "登録する", class: "form-submit-button" %>
          </div>
        <% end %>

        <div class="auth-links">
          <%= render "devise/shared/links" %>
        </div>
      </section>
    </main>
  </div>
</div>