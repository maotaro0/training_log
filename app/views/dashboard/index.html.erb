<%= stylesheet_link_tag "dashboard", "data-turbo-track": "reload" %>

<div class="dashboard-page">
  <div class="dashboard-shell">

    <header class="app-header">
      <div class="profile-area">
        <div class="profile-avatar">
          <%= current_user.email.first.upcase %>
        </div>

        <div class="profile-text">
          <h1>あなたのジムログ</h1>
          <p>今日もコツコツ、理想の自分へ</p>
        </div>
      </div>

      <button class="notification-button" type="button">
        ♢
        <span class="notification-dot"></span>
      </button>
    </header>


    <main class="dashboard-main">

      <section class="status-grid">

        <div class="status-card">
          <div class="status-icon status-icon-blue">
            ✓
          </div>

          <div class="status-content">
            <p class="status-label">今月</p>

            <div class="status-number">
              <strong><%= @monthly_training_count %></strong>
              <span>回</span>
            </div>

            <div class="status-progress">
              <div class="status-progress-bar"></div>
            </div>

            <p class="status-note">
              今月も積み上げ中
            </p>
          </div>
        </div>


        <div class="status-card">
          <div class="status-icon status-icon-orange">
            🔥
          </div>

          <div class="status-content">
            <p class="status-label">継続</p>

            <div class="status-number">
              <strong>―</strong>
              <span>日</span>
            </div>

            <p class="status-note">
              連続日数は今後追加予定
            </p>
          </div>
        </div>

      </section>


      <section class="workout-hero">
        <div class="hero-overlay"></div>

        <div class="hero-content">

          <p class="hero-kicker">
            TODAY'S WORKOUT
          </p>

          <% if @latest_record %>

            <h2>
              <%= @latest_record.exercise.name %> の日
            </h2>

            <p class="hero-description">
              前回は
              <% if @latest_record.weight_kg.present? %>
                <%= number_with_precision(
                      @latest_record.weight_kg,
                      precision: 1,
                      strip_insignificant_zeros: true
                    ) %>kg
              <% else %>
                自重
              <% end %>

              × <%= @latest_record.reps %>回。

              今日も前回の自分を超えていきましょう。
            </p>

          <% else %>

            <h2>今日のトレーニング</h2>

            <p class="hero-description">
              最初のトレーニングを記録してみましょう。
            </p>

          <% end %>


          <div class="hero-actions">

            <%= link_to new_training_record_path,
                        class: "hero-button hero-button-primary" do %>

              <span class="hero-button-icon">▶</span>
              <span>新しく記録開始</span>

            <% end %>


            <button
              type="button"
              class="hero-button hero-button-secondary"
              disabled>

              <span class="hero-button-icon">▣</span>
              <span>前回コピー開始</span>

            </button>

          </div>
        </div>
      </section>


      <section class="dashboard-card">

        <div class="card-header">

          <div class="card-title">
            <span class="card-title-icon growth-icon">▥</span>
            <h2>直近の成長ハイライト</h2>
          </div>

          <%= link_to "すべて見る ›",
                      training_records_path,
                      class: "card-link" %>

        </div>


        <% if @growth_record %>

          <% difference = @growth_record.weight_difference %>

          <div class="growth-box">

            <div class="exercise-icon">
              🏋
            </div>

            <div class="growth-info">

              <strong class="growth-name">
                <%= @growth_record.exercise.name %>
              </strong>


              <% if difference > 0 %>

                <span class="growth-badge growth-positive">
                  +<%= number_with_precision(
                        difference,
                        precision: 1,
                        strip_insignificant_zeros: true
                      ) %>kg UP!
                </span>

              <% elsif difference == 0 %>

                <span class="growth-badge growth-neutral">
                  ±0kg
                </span>

              <% else %>

                <span class="growth-badge growth-negative">
                  <%= number_with_precision(
                        difference,
                        precision: 1,
                        strip_insignificant_zeros: true
                      ) %>kg
                </span>

              <% end %>


              <% if @personal_best_record %>

                <p class="personal-best">
                  自己ベスト：

                  <%= number_with_precision(
                        @personal_best_record.weight_kg,
                        precision: 1,
                        strip_insignificant_zeros: true
                      ) %>kg

                  （<%= @personal_best_record.reps %>回）
                </p>

              <% end %>

            </div>

            <div class="growth-message">
              昨日の自分を<br>
              超えていこう。
            </div>

          </div>

        <% else %>

          <p class="empty-message">
            同じ種目を2回以上記録すると、
            ここに成長が表示されます。
          </p>

        <% end %>

      </section>


      <section class="dashboard-card chart-card">

        <div class="card-header">

          <div class="card-title">
            <span class="card-title-icon chart-icon">↗</span>
            <h2>成長グラフ</h2>

            <span class="card-subtitle">
              最大重量推移
            </span>
          </div>


          <% if @chart_exercises.any? %>

            <%= form_with url: root_path,
                          method: :get,
                          local: true do |form| %>

              <%= form.collection_select(
                    :exercise_id,
                    @chart_exercises,
                    :id,
                    :name,
                    { selected: @selected_exercise&.id },
                    {
                      class: "chart-select",
                      onchange: "this.form.submit();"
                    }
                  ) %>

            <% end %>

          <% end %>

        </div>


        <% if @selected_exercise %>

          <div class="chart-wrapper">

            <canvas
              id="weightProgressChart"
              data-labels='<%= @chart_labels.to_json %>'
              data-weights='<%= @chart_weights.to_json %>'>
            </canvas>

          </div>

        <% else %>

          <p class="empty-message">
            重量を記録するとグラフが表示されます。
          </p>

        <% end %>

      </section>


      <section class="dashboard-card recent-card">

        <div class="card-header">

          <div class="card-title">
            <span class="card-title-icon history-icon">◴</span>

            <h2>
              前回の記録

              <% if @latest_record %>
                （<%= @latest_record.training_day.strftime("%m/%d") %>）
              <% end %>
            </h2>
          </div>

          <%= link_to "すべて見る ›",
                      training_records_path,
                      class: "card-link" %>

        </div>


        <% if @latest_record %>

          <%= link_to edit_training_record_path(@latest_record),
                      class: "recent-record-row" do %>

            <div class="exercise-icon">
              🏋
            </div>

            <div class="recent-record-info">

              <strong>
                <%= @latest_record.exercise.name %>
              </strong>

              <p>

                <% if @latest_record.weight_kg.present? %>

                  <%= number_with_precision(
                        @latest_record.weight_kg,
                        precision: 1,
                        strip_insignificant_zeros: true
                      ) %>kg

                <% else %>

                  自重

                <% end %>

                × <%= @latest_record.reps %>回

                &nbsp;

                <%= @latest_record.set_count %>セット

              </p>

            </div>

            <span class="recent-arrow">
              ›
            </span>

          <% end %>

        <% else %>

          <p class="empty-message">
            まだトレーニング記録がありません。
          </p>

        <% end %>

      </section>

    </main>


    <nav class="bottom-nav">

      <%= link_to root_path,
                  class: "nav-item nav-item-active" do %>

        <span class="nav-symbol">⌂</span>
        <span>ホーム</span>

      <% end %>


      <%= link_to new_training_record_path,
                  class: "nav-item" do %>

        <span class="nav-symbol nav-plus">＋</span>
        <span>記録する</span>

      <% end %>


      <%= link_to training_records_path,
                  class: "nav-item" do %>

        <span class="nav-symbol">▥</span>
        <span>成長分析</span>

      <% end %>


      <%= link_to edit_user_registration_path,
                  class: "nav-item" do %>

        <span class="nav-symbol">⚙</span>
        <span>設定</span>

      <% end %>

    </nav>

  </div>
</div>