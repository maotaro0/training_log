
<div class="dashboard-page">
  <div class="dashboard-shell">

    <header class="app-header">
      <div class="profile-area">
        <div class="profile-avatar">
          <%= current_user.email.first.upcase %>
        </div>

        <div class="profile-text">
          <h1>ジムログ</h1>
          <p>焦りは禁物!無理しちゃ沈没!<br>
            今日もコツコツ、理想の自分へ!</p>
        </div>
      </div>

      <button class="notification-button" type="button">
        ♢
        <span class="notification-dot"></span>
      </button>
    </header>


    <main class="dashboard-main">
      <%= link_to "種目管理へ", exercises_path, class: "card-link" %>
        <%= link_to "記録", new_workout_path, class: "card-link" %>
        <%= link_to "履歴", workouts_path, class: "card-link" %>
      <%= link_to "前回のセットをコピー",
            new_workout_path(copy_previous: true),
            class: "card-link" %>
      
      <section class="status-grid">

        <div class="status-card">
          <div class="status-icon status-icon-blue">
            ✓
          </div>

          <div class="status-content">
            <p class="status-label">今月</p>

            <div class="status-number">
              <strong><%= @monthly_training_count %></strong>
              <span>回</span>
            </div>

            <div class="status-progress">
              <div class="status-progress-bar"></div>
            </div>

            <p class="status-note">
              今月も積み上げ中
            </p>
          </div>
        </div>


        <div class="status-card">
          <div class="status-icon status-icon-orange">
            🔥
          </div>

          <div class="status-content">
            <p class="status-label">継続</p>

            <div class="status-number">
              <strong>―</strong>
              <span>日</span>
            </div>

            <p class="status-note">
              連続日数は今後追加予定
            </p>
          </div>
        </div>

      </section>


      <section class="workout-hero">
        <div class="hero-overlay"></div>

        <div class="hero-content">

          <p class="hero-kicker">
            TODAY'S WORKOUT
          </p>

          <% if @latest_workout && @latest_record && @latest_set %>

    <h2>
      <%= @latest_record.exercise.name %> の日
    </h2>

    <p class="hero-description">
      前回は

      <% if @latest_set.weight_kg.present? %>
        <%= number_with_precision(
            @latest_set.weight_kg,
            precision: 1,
            strip_insignificant_zeros: true
          ) %>kg
      <% else %>
        自重
      <% end %>

      × <%= @latest_set.reps %>回。

      今日も前回の自分を超えていきましょう。
    </p>

  <% else %>

  <h2>今日のトレーニング</h2>

    <p class="hero-description">
      最初のトレーニングを記録してみましょう。
    </p>

  <% end %>

          <div class="hero-actions">
  <%= link_to new_workout_path,
            class: "hero-button hero-button-primary" do %>
    <span class="hero-button-icon">▶</span>
    <span>新しく記録開始</span>
  <% end %>

  <% if @latest_workout %>
    <%= link_to new_workout_path(copy_previous: true),
              class: "hero-button hero-button-secondary" do %>
      <span class="hero-button-icon">▣</span>
      <span>前回のセットをコピー</span>
    <% end %>
  <% else %>
    <button
      type="button"
      class="hero-button hero-button-secondary"
      disabled>
      <span class="hero-button-icon">▣</span>
      <span>前回のセットをコピー</span>
    </button>
  <% end %>


          </div>
        </div>
      </section>


      <section class="dashboard-card">

        <div class="card-header">

          <div class="card-title">
            <%= link_to "すべて見る ›",
            workouts_path,
            class: "card-link" %>

          <%= link_to "すべて見る ›",
                      training_records_path,
                      class: "card-link" %>

        </div>


  <% if @growth_record %>

    <div class="growth-box">
      <div class="exercise-icon">
        🏋
      </div>

      <div class="growth-info">
        <strong class="growth-name">
          <%= @growth_record.name %>
        </strong>

        <% if @weight_difference > 0 %>
          <span class="growth-badge growth-positive">
            +<%= @weight_difference.round(1) %>kg UP!
          </span>
        <% elsif @weight_difference == 0 %>
          <span class="growth-badge growth-neutral">
            ±0kg
          </span>
        <% else %>
          <span class="growth-badge growth-negative">
            <%= @weight_difference.round(1) %>kg
          </span>
        <% end %>

        <p class="personal-best">
          自己ベスト：
          <%= @personal_best_weight.round(1) %>kg
        </p>
      </div>

      <div class="growth-message">
        昨日の自分を<br>
        超えていこう。
      </div>
    </div>

  <% else %>

    <p class="empty-message">
      同じ種目の重量を異なる2日以上記録すると、
      ここに成長が表示されます。
    </p>

  <% end %>

      </section>


      <section class="dashboard-card chart-card">

        <div class="card-header">

          <div class="card-title">
            <span class="card-title-icon chart-icon">↗</span>
            <h2>成長グラフ</h2>

            <span class="card-subtitle">
              最大重量推移
            </span>
          </div>


          <% if @chart_exercises.any? %>

            <%= form_with url: root_path,
                          method: :get,
                          local: true do |form| %>

              <%= form.collection_select(
                    :exercise_id,
                    @chart_exercises,
                    :id,
                    :name,
                    { selected: @selected_exercise&.id },
                    {
                      class: "chart-select",
                      onchange: "this.form.submit();"
                    }
                  ) %>

            <% end %>

          <% end %>

        </div>


        <% if @selected_exercise %>

          <div class="chart-wrapper">

            <canvas
              id="weightProgressChart"
              data-labels='<%= @chart_labels.to_json %>'
              data-weights='<%= @chart_weights.to_json %>'>
            </canvas>

          </div>

        <% else %>

          <p class="empty-message">
            重量を記録するとグラフが表示されます。
          </p>

        <% end %>

      </section>


<section class="dashboard-card recent-card">

  <div class="card-header">
    <div class="card-title">
      <span class="card-title-icon history-icon">◴</span>

      <h2>
        前回の記録

        <% if @latest_workout %>
          （<%= @latest_workout.date.strftime("%m/%d") %>）
        <% end %>
      </h2>
    </div>

    <%= link_to "すべて見る ›",
                workouts_path,
                class: "card-link" %>
  </div>

  <% if @latest_workout %>

    <% @latest_workout.workout_records.each do |record| %>

      <%= link_to workout_path(@latest_workout),
                  class: "recent-record-row" do %>

        <div class="exercise-icon">
          🏋
        </div>

        <div class="recent-record-info">
          <strong>
            <%= record.exercise.name %>
          </strong>

          <p>
            <%= record.workout_sets.size %>セット
          </p>

          <% record.workout_sets.sort_by(&:set_number).each do |set| %>
            <p>
              <%= set.set_number %>セット目：

              <% if set.weight_kg.present? %>
                <%= number_with_precision(
                      set.weight_kg,
                      precision: 1,
                      strip_insignificant_zeros: true
                    ) %>kg
              <% else %>
                自重
              <% end %>

              × <%= set.reps %>回
            </p>
          <% end %>
        </div>

        <span class="recent-arrow">›</span>

      <% end %>
    <% end %>

  <% else %>

    <p class="empty-message">
      まだトレーニング記録がありません。
    </p>

  <% end %>

</section>

    </main>

<%= render "shared/bottom_nav", active: :home %>

  </div>
</div>