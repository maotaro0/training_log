<h1>トレーニング記録一覧</h1>

<p>
  今月のトレーニング回数：
  <%= current_user.monthly_training_count %> 回
</p>

<h2>重量推移グラフ</h2>
<%= form_with url: training_records_path, method: :get, local: true do |form| %>
  <%= form.label :training_name, "種目を選択" %>

  <%= form.select :training_name,
                  options_for_select(@training_names, @selected_training_name),
                  {},
                  onchange: "this.form.submit();" %>
<% end %>

<div>
  <canvas
    id="weightProgressChart"
    data-labels="<%= @chart_labels.to_json %>"
    data-weights="<%= @chart_weights.to_json %>">
  </canvas>
</div>


<%= link_to "新しいトレーニングを記録する", new_training_record_path %>

<% if @training_records.any? %>

<% @training_records.each do |training_record| %>
  <div>
    <p>
      日付：
      <%= training_record.training_day %>
    </p>

    <p>
      種目：
      <%= training_record.training_name %>
    </p>

    <p>
      重量：
      <%= training_record.weight_kg %> kg
    </p>
      <% previous_record = training_record.previous_record %>

      <% if previous_record.present? %>
        <p>
          前回重量：
           <%= previous_record.weight_kg %> kg
        </p>

     <% difference = training_record.weight_difference %>

    <% if difference.present? %>
     <p>
         前回との差：
      <% if difference > 0 %>
        +<%= difference %> kg
        （前回よりアップ）
      <% elsif difference == 0 %>
        ±0 kg
        （前回と同じ）
      <% else %>
        <%= difference %> kg
      （前回よりダウン）
      <% end %>
     </p>
    <% end %>

    <% growth = training_record.growth_from_first %>

    <% if growth.present? %>
      <p>
        開始時から：
        <% if growth > 0 %>
          +<%= growth %> kg
        <% elsif growth == 0 %>
          ±0 kg
        <% else %>
          <%= growth %> kg
        <% end %>
       </p>
    <% end %>

    <% else %>
     <p>前回記録なし</p>
    <% end %>

    <p>
      回数：
      <%= training_record.reps %> 回
    </p>

    <p>
      セット数：
      <%= training_record.set_count %> セット
    </p>

    <%= link_to "編集", edit_training_record_path(training_record) %>

    <%= button_to "削除",
              training_record_path(training_record),
              method: :delete,
              data: { turbo_confirm: "この記録を削除しますか？" } %>
  </div>

  <hr>
<% end %>

<% else %>

  <p>まだトレーニング記録がありません。</p>

<% end %>